<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb4_autonav_system</name>
  <version>0.1.0</version>
  <description>TurtleBot 4 Autonomous Navigation System – wrapper package for Simulation, SLAM, and Nav2.</description>
  <maintainer email="jack@todo.todo">jack</maintainer>
  <license>Apache-2.0</license>

  <!-- Simulation -->
  <exec_depend>turtlebot4_ignition_bringup</exec_depend>

  <!-- Navigation / SLAM -->
  <exec_depend>turtlebot4_navigation</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <!-- Visualization -->
  <exec_depend>turtlebot4_viz</exec_depend>

  <!-- Teleoperation -->
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- Autonomous Navigation (nav2_simple_commander) -->
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- YOLO Object Detection -->
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
